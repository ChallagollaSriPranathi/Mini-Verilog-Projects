
module baugh_wooley_8bit(
    input  signed [7:0] A,
    input  signed [7:0] B,
    output signed [15:0] P
);

wire signed [15:0] M[7:0];

assign M[0] = A[0] ? ({ {8{B[7]}}, B } << 0) : 16'd0;
assign M[1] = A[1] ? ({ {8{B[7]}}, B } << 1) : 16'd0;
assign M[2] = A[2] ? ({ {8{B[7]}}, B } << 2) : 16'd0;
assign M[3] = A[3] ? ({ {8{B[7]}}, B } << 3) : 16'd0;
assign M[4] = A[4] ? ({ {8{B[7]}}, B } << 4) : 16'd0;
assign M[5] = A[5] ? ({ {8{B[7]}}, B } << 5) : 16'd0;
assign M[6] = A[6] ? ({ {8{B[7]}}, B } << 6) : 16'd0;

assign M[7] = A[7] ? -(({ {8{B[7]}}, B } << 7)) : 16'd0;

assign P = M[0] + M[1] + M[2] + M[3] +
           M[4] + M[5] + M[6] + M[7];

endmodule
