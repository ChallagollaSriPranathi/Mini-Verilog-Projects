
module tb_baugh_wooley_16bit;

    reg  signed [15:0] A;
    reg  signed [15:0] B;
    wire signed [31:0] P;

    baugh_wooley_16bit uut (
        .A(A),
        .B(B),
        .P(P)
    );

    initial begin
        $display("------------------------------------------------");
        $display(" Time\tA\t\tB\t\tProduct");
        $display("------------------------------------------------");
        $monitor("%0t\t%d\t\t%d\t\t%d", $time, A, B, P);

        A =   16'd100;    B =   16'd200;    #10;   //  100 x   200 =       20000
        A =  -16'd150;    B =   16'd50;     #10;   // -150 x    50 =       -7500
        A =  -16'd200;    B =  -16'd100;    #10;   // -200 x  -100 =       20000
        A =   16'd500;    B =  -16'd20;     #10;   //  500 x   -20 =      -10000
        A = -16'd1000;    B =   16'd70;     #10;   //-1000 x    70 =      -70000
        A =   16'd250;    B =   16'd40;     #10;   //  250 x    40 =       10000
        A =  -16'd300;    B =   16'd60;     #10;   // -300 x    60 =      -18000
        A =  -16'd120;    B =  -16'd120;    #10;   // -120 x  -120 =       14400
        A =    16'd0;     B =  16'd5500;    #10;   //    0 x  5500 =           0
        A =    16'd1;     B = -16'd32768;   #10;   //    1 x -32768 =     -32768
        A =   -16'd1;     B =   -16'd1;     #10;   //   -1 x    -1 =           1
        A =  16'd6400;    B =    16'd20;    #10;   // 6400 x    20 =      128000
        A =  -16'd750;    B =    16'd30;    #10;   // -750 x    30 =      -22500
        A =   16'd150;    B =  -16'd150;    #10;   //  150 x  -150 =      -22500
        A =  16'd32767;   B =  16'd32767;   #10;   // max x max = 1073676289
        A = -16'd32768;   B = -16'd32768;   #10;   // min x min = 1073741824
        A =  16'd32767;   B = -16'd32768;   #10;   // max x min = -1073709056
        A = -16'd32768;   B =  16'd32767;   #10;   // min x max = -1073709056
        A =  16'd12345;   B =  16'd6789;    #10;   // 12345 x 6789 =  83835405
        A = -16'd9999;    B =  16'd9999;    #10;   // -9999 x 9999 = -99980001
        #10;
        $finish;
    end

endmodule
