
module tb_baugh_wooley_8bit;

    reg signed [7:0] A;
    reg signed [7:0] B;
    wire signed [15:0] P;

    baugh_wooley_8bit uut (
        .A(A),
        .B(B),
        .P(P)
    );

    initial begin

        $display("------------------------------------------------");
        $display(" Time\tA\tB\tProduct");
        $display("------------------------------------------------");

        $monitor("%0t\t%d\t%d\t%d", $time, A, B, P);

        A =   8'd12;    B =   8'd10;    #10;
        A =  -8'd15;    B =    8'd5;    #10;
        A =  -8'd20;    B =  -8'd10;    #10;
        A =   8'd50;    B =   -8'd2;    #10;
        A = -8'd100;    B =    8'd7;    #10;
        A =   8'd25;    B =    8'd4;    #10;
        A =  -8'd30;    B =    8'd6;    #10;
        A =  -8'd12;    B =  -8'd12;    #10;
        A =    8'd0;    B =   8'd55;    #10;
        A =    8'd1;    B = -8'd128;    #10;
        A =   -8'd1;    B =   -8'd1;    #10;
        A =   8'd64;    B =    8'd2;    #10;
        A =  -8'd75;    B =    8'd3;    #10;
        A =   8'd15;    B =  -8'd15;    #10;
        A = -8'd128;    B = -8'd128;    #10;

        #10;
        $finish;

    end

endmodule
