module tb_baugh_wooley_4bit;

    reg signed [3:0] A;
    reg signed [3:0] B;
    wire signed [7:0] P;

    baugh_wooley_4bit uut (
        .A(A),
        .B(B),
        .P(P)
    );

    initial begin

        $display("------------------------------------------------");
        $display(" Time\tA\tB\tProduct");
        $display("------------------------------------------------");

        $monitor("%0t\t%d\t%d\t%d", $time, A, B, P);

        A =  4'd3;   B =  4'd2;   #10;
        A = -4'd3;   B =  4'd2;   #10;
        A = -4'd4;   B = -4'd2;   #10;
        A =  4'd7;   B = -4'd1;   #10;
        A = -4'd8;   B =  4'd7;   #10;
        A =  4'd5;   B =  4'd5;   #10;
        A = -4'd5;   B =  4'd5;   #10;
        A = -4'd6;   B = -4'd3;   #10;
        A =  4'd0;   B =  4'd7;   #10;
        A =  4'd1;   B = -4'd8;   #10;
        A = -4'd1;   B = -4'd1;   #10;
        A =  4'd6;   B =  4'd3;   #10;
        A = -4'd7;   B =  4'd4;   #10;
        A =  4'd2;   B = -4'd6;   #10;
        A = -4'd8;   B = -4'd8;   #10;

        $display("------------------------------------------------");

        $finish;
    end

endmodule
